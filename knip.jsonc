// Knip: unused files, exports and dependencies. Report only: CI runs it with jscpd
// through devkit-no-bloat --warn-only against .no-bloat.json
// (.github/workflows/no-bloat.yml). Removals follow capsid/conventions.md 1.4 and 3.6.
//
// Framework entries. Knip's plugins enable themselves from each workspace's
// package.json. Checked against knip.dev and the plugin sources on 2026-10-09:
// - react-router (apps/web): reads app/routes.ts and adds root.tsx,
//   entry.client.tsx, entry.server.tsx and every route module as entries.
// - wrangler: reads `main` from wrangler.{json,jsonc,toml}. The real
//   apps/web/wrangler.jsonc is gitignored (only wrangler.jsonc.example is
//   committed), so its `main` (workers/app.ts) is listed here by hand.
// - expo (apps/mobile): reads app.json and babel.config. It adds no entries for
//   the expo-router app/ directory, so app/**/* is listed here by hand.
// The other plugins that enable (vite, vitest, playwright, drizzle and the rest)
// keep their defaults.
{
  "$schema": "https://unpkg.com/knip@6.38.0/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{ts,mjs}"],
      "project": ["scripts/**/*.{ts,mjs}"]
    },
    "apps/web": {
      // workers/app.ts is wrangler's `main`; the *.setup.ts files are Playwright
      // setup projects matched by a RegExp testMatch, which Knip does not read.
      // app/site.ts and app/islands/*.ts are devkit siteScript's entries (/site.js
      // and the islands it starts, vite.config.ts), named by convention, not import.
      "entry": [
        "workers/app.ts",
        "scripts/*.mjs",
        "e2e/*.setup.ts",
        "app/site.ts",
        "app/islands/*.ts"
      ],
      // .css is in the pattern so `@import "tailwindcss"` in app/app.css counts
      // (knip.dev/features/compilers: the css compiler runs when tailwindcss is a
      // dependency, but only on project files).
      "project": [
        "app/**/*.{ts,tsx,css}",
        "workers/**/*.ts",
        "scripts/**/*.mjs",
        "test/**/*.ts",
        "e2e/**/*.ts"
      ],
      // `cloudflare:workers` and `cloudflare:test` are workerd built-in modules,
      // not npm packages. @readium/navigator's types import
      // @readium/navigator-html-injectables without declaring it; the direct
      // dependency gives them the 2.5 types (BasicTextSelection.locator), and
      // without it tsc picks up mobile's older 2.4.2. @better-auth/passkey is site-runtime
      // ./sign-in's peer: its passkey plugin, imported there, not here.
      "ignoreDependencies": [
        "cloudflare",
        "@readium/navigator-html-injectables",
        "@better-auth/passkey"
      ],
      // `./+types/<route>` modules are generated by `react-router typegen` into
      // .react-router/types (gitignored) and reached through tsconfig rootDirs.
      "ignoreUnresolved": ["^\\./\\+types/"]
    },
    "apps/mobile": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "scripts/*.{ts,mjs}",
        "plugins/*.js",
        "metro.config.js",
        "tailwind.config.js"
      ],
      // supabase/functions is Deno code with URL imports, deployed by the
      // Supabase CLI, outside Node resolution.
      "project": [
        "**/*.{ts,tsx,js,mjs,cjs,css}",
        "!assets/**",
        "!supabase/**"
      ],
      // Knip's metro plugin executes metro.config.js from the repo root, where
      // NativeWind cannot find ./tailwind.config and the load fails. The file stays
      // an entry above, so its own requires are still counted.
      "metro": false
    },
    "apps/discord": {
      "entry": ["src/main.tsx"],
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "packages/core": {
      "project": ["src/**/*.ts", "test/**/*.ts", "drizzle.config.ts"]
    },
    "packages/api": {
      "project": ["src/**/*.ts"]
    },
    "packages/types": {
      "project": ["src/**/*.ts"]
    },
    "packages/utils": {
      "project": ["src/**/*.ts"]
    }
  }
}
