{
  "name": "foxing",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "pnpm --filter mobile start",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "type-check": "pnpm --filter mobile exec tsc --noEmit && pnpm --filter web exec tsc --noEmit",
    "lint": "turbo lint"
  },
  "devDependencies": {
    "ts-morph": "^28.0.0",
    "tsx": "^4.22.0",
    "turbo": "2.9.16",
    "typescript": "^5.0.0"
  }
}
