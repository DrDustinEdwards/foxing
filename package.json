{
  "name": "foxing",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=26 <27"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "pnpm --filter mobile start",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "type-check": "pnpm --filter mobile exec tsc --noEmit && pnpm --filter web run type-check",
    "lint": "turbo lint",
    "lint:cf": "biome check packages/core packages/api packages/client packages/types apps/web",
    "check:bloat": "devkit-no-bloat",
    "check:console": "devkit-console",
    "check:migrations": "devkit-migrations packages/core/migrations --manifest packages/core/migrations-manifest.json --min 13",
    "check:page-weight": "devkit-route-weight --client apps/web/build/client"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@biomejs/biome": "^2.0.0",
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.20.14",
    "fast-xml-parser": "^5.8.0",
    "jszip": "^3.10.1",
    "p-limit": "^6.2.0",
    "turbo": "2.9.16",
    "typescript": "^5.0.0"
  }
}
