{
  "name": "foxing",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=26 <27"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "pnpm --filter mobile start",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "type-check": "pnpm --filter mobile exec tsc --noEmit && pnpm --filter web run type-check",
    "lint": "turbo lint",
    "lint:cf": "biome check packages/core packages/api packages/client packages/types apps/web",
    "check:knip": "knip --no-exit-code --reporter compact --reporter ./scripts/no-bloat/knip-summary.mjs",
    "check:jscpd": "jscpd --baseline scripts/no-bloat/jscpd-baseline.json && node scripts/no-bloat/jscpd-summary.mjs",
    "check:page-weight": "devkit-route-weight --client apps/web/build/client"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@biomejs/biome": "^2.0.0",
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.11.0",
    "fast-xml-parser": "^5.8.0",
    "jscpd": "5.3.2",
    "jszip": "^3.10.1",
    "knip": "6.38.0",
    "p-limit": "^6.2.0",
    "ts-morph": "^28.0.0",
    "turbo": "2.9.16",
    "typescript": "^5.0.0"
  }
}
