{
  "name": "foxing",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev:mobile": "npm run start -w mobile",
    "dev:web": "npm run dev -w web",
    "build:web": "npm run build -w web",
    "type-check": "npm exec -w mobile -- tsc --noEmit && npm run type-check -w web",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error",
    "check:bloat": "devkit-no-bloat",
    "check:console": "devkit-console",
    "check:migrations": "devkit-migrations packages/core/migrations --manifest packages/core/migrations-manifest.json --min 13",
    "check:page-weight": "devkit-route-weight --client apps/web/build/client",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.53.0",
    "fast-xml-parser": "5.12.1",
    "jszip": "3.10.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "p-limit": "6.2.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "overrides": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "engines": {
    "node": ">=26 <27"
  }
}
