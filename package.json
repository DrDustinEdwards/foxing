{
  "name": "foxing",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run start -w mobile",
    "dev:web": "npm run dev -w web",
    "build:web": "npm run build -w web",
    "type-check": "npm exec -w mobile -- tsc --noEmit && npm run type-check -w web",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error",
    "check:bloat": "devkit-no-bloat",
    "check:console": "devkit-console",
    "check:migrations": "devkit-migrations packages/core/migrations --manifest packages/core/migrations-manifest.json --min 13",
    "check:page-weight": "devkit-route-weight --client apps/web/build/client"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@biomejs/biome": "^2.0.0",
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.23.0",
    "fast-xml-parser": "^5.8.0",
    "jszip": "^3.10.1",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "p-limit": "^6.2.0",
    "typescript": "^5.0.0",
    "vite": "^8.0.0"
  },
  "overrides": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
