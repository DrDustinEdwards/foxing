{
  "name": "foxing",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "scripts": {
    "dev:mobile": "pnpm --filter mobile start",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "type-check": "pnpm --filter mobile exec tsc --noEmit && pnpm --filter web exec tsc --noEmit",
    "lint": "turbo lint"
  },
  "devDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "turbo": "latest",
    "typescript": "^5.0.0"
  }
}
