{
  "name": "foxing-admin-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Foxing Admin: the admin MCP server for foxing.app, a wrapper over /api/v1/admin. Contains no policy.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "wrangler types && tsc -b",
    "test": "node --import ./test/resolve-ts.mjs --test \"test/**/*.test.ts\"",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "check:conformance": "devkit-conformance"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@dustinedwards/site-runtime": "github:DrDustinEdwards/site-runtime#v0.71.0",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.32.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.20.20",
    "@modelcontextprotocol/conformance": "0.2.0-alpha.11",
    "typescript": "5.9.3",
    "wrangler": "4.151.3"
  }
}
