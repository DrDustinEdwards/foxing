{
  "name": "foxing-admin-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Foxing Admin: the admin MCP server for foxing.app, a wrapper over /api/v1/admin. Contains no policy.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "wrangler types && tsc -b",
    "test": "node --import ./test/resolve-ts.mjs --test \"test/**/*.test.ts\"",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "check:conformance": "devkit-conformance"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@drdustinedwards/site-helpers": "github:DrDustinEdwards/prelum#v0.69.0",
    "@dustinedwards/site-runtime": "github:DrDustinEdwards/site-runtime#v0.183.2",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.34.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.68.0",
    "@modelcontextprotocol/conformance": "0.2.0-alpha.12",
    "typescript": "7.0.2",
    "wrangler": "4.168.0"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "core-js-pure": false,
    "esbuild": false,
    "workerd": false
  }
}
