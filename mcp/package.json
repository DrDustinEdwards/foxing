{
  "name": "foxing-admin-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Foxing Admin: the admin MCP server for foxing.app, a wrapper over /api/v1/admin. Contains no policy.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "wrangler types && tsc -b",
    "test": "node --import ./test/resolve-ts.mjs --test \"test/**/*.test.ts\"",
    "build": "wrangler deploy --dry-run --outdir=dist"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.1.0",
    "@dustinedwards/site-runtime": "github:DrDustinEdwards/site-runtime#v0.7.0",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.24.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wrangler": "4.141.0"
  }
}
