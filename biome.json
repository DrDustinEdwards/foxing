{
  "$schema": "https://biomejs.dev/schemas/2.0.0/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "packages/core/**",
      "packages/api/**",
      "apps/web/**",
      "!**/build/**",
      "!**/.react-router/**",
      "!**/worker-configuration.d.ts",
      "!**/*.gen.ts",
      "!apps/web/app/app.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true },
    "domains": { "types": "recommended" }
  },
  "assist": {
    "actions": { "source": { "organizeImports": "off" } }
  },
  "overrides": [
    {
      "includes": [
        "packages/core/src/**",
        "packages/api/src/**",
        "apps/web/workers/**",
        "apps/web/app/**/*.server.ts"
      ],
      "linter": {
        "rules": { "nursery": { "noFloatingPromises": "error" } }
      }
    }
  ]
}
