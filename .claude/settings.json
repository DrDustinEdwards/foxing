{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-em-dash.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/scoped-git-add.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/apps/web\" && npx tsc --noEmit 2>&1 | tail -20; exit ${PIPESTATUS[0]}'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'osascript -e '\\''display notification \"Claude Code is done\" with title \"Foxing\"'\\'' 2>/dev/null || notify-send '\\''Foxing'\\'' '\\''Claude Code is done'\\'' 2>/dev/null || true'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(npm run *)",
      "Bash(npx tsc *)",
      "Bash(npx wrangler types*)",
      "Bash(npx wrangler d1 execute * --command *SELECT*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(npx vitest *)",
      "Bash(git show *)",
      "Bash(git log *)",
      "Bash(git branch*)",
      "Bash(git submodule update --init*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npm run deploy*)",
      "Bash(pnpm run deploy*)",
      "Bash(npx wrangler deploy*)",
      "Bash(npx wrangler d1 migrations apply*)",
      "Bash(npx wrangler d1 execute *DELETE*)",
      "Bash(npx wrangler d1 execute *DROP*)",
      "Bash(npx wrangler secret*)",
      "Bash(npx supabase functions deploy*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Read(./.env*)",
      "Read(./.dev.vars)",
      "Read(./apps/web/.dev.vars)"
    ]
  },
  "defaultMode": "acceptEdits"
}
