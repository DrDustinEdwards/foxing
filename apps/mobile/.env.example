EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SENTRY_DSN=

# ANTHROPIC_API_KEY is not needed in the app.
# All AI calls route through the ai-companion Supabase Edge Function,
# which reads the key from Deno.env (Supabase secrets), not from .env.
# Set it as a Supabase Edge Function secret instead:
# npx supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
