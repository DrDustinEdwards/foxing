NEXT_PUBLIC_SUPABASE_URL=https://ekjpsuewrkvqzbuteurc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_BOOKSHOP_AFFILIATE=

# IndexNow (Bing/Yandex instant crawl notification).
# 1. Generate a stable UUID and set it as INDEXNOW_KEY.
# 2. Put the same UUID inside a static file at apps/web/public/{UUID}.txt
#    so verification at https://foxing.app/{UUID}.txt returns the key.
# When unset, notifyIndexNow() is a no-op.
INDEXNOW_KEY=

# Sentry error tracking. SENTRY_DSN is read by sentry.*.config.ts at runtime.
# SENTRY_AUTH_TOKEN is needed for source map uploads during build. Get it
# from recova.sentry.io/settings/auth-tokens/ and add to Vercel Dashboard
# (foxing project) Settings -> Environment Variables (Production + Preview).
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Cloudflare R2 storage. lib/r2.ts uses the key pair to sign S3 requests;
# the four public URL vars document the buckets exposed via r2.dev. Until
# nameservers move to Cloudflare and custom domains are wired, the URLs
# are also hardcoded as fallbacks in lib/r2.ts R2_PUBLIC_URLS.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_COVERS_URL=https://pub-d196a43c0eb646b492c40d4f5e588943.r2.dev
R2_AVATARS_URL=https://pub-632e7267e83d4335b27c6425f95e6e6d.r2.dev
R2_JOURNAL_IMAGES_URL=https://pub-c53c4e2f4743416db3244c097f4fac88.r2.dev
R2_EPUBS_URL=https://pub-c44d42294a474222a1627ab8644565cb.r2.dev
