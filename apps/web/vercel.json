{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && rm -rf node_modules apps/*/node_modules packages/*/node_modules && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter web build",
  "crons": [
    {
      "path": "/api/cron/celebrity-picks",
      "schedule": "0 9 2 * *"
    },
    {
      "path": "/api/cron/celebrity-picks",
      "schedule": "0 9 12 * *"
    },
    {
      "path": "/api/cron/publish-scheduled-journal",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/cleanup-journal-versions",
      "schedule": "0 3 * * 0"
    }
  ]
}
