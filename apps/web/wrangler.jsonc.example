{
  // Copy to wrangler.jsonc (gitignored) and fill in real IDs.
  // Secrets (BETTER_AUTH_SECRET, TURNSTILE_SITE_KEY and TURNSTILE_SECRET_KEY, the GOOGLE_ and APPLE_ sign-in settings, ANTHROPIC_API_KEY, CARREL_SITE_KEY) are set via
  // `wrangler secret put`, never here.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "foxing",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./build/client" },
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "upload_source_maps": true,
  // The public pages' edge cache (workers/app.ts, site-runtime ./edge-cache). The default export
  // is the GATEWAY, cache disabled, so it runs on every request: the APIs, auth, writes, media,
  // reader assets and every signed-in request answer there and are never stored. An anonymous GET
  // of a public catalog page goes to the Renderer with its path and query as the cache key, and the
  // Renderer's responses are stored when a route marks them shared (publicPageHeaders). Carrel's
  // and the admin API's writes purge the "pages" tag. No `cross_version_cache`, so the Worker
  // version stays in the key and every deploy starts cold.
  "cache": { "enabled": true },
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "Renderer": { "type": "worker", "cache": { "enabled": true } }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foxing",
      "database_id": "<D1_DATABASE_ID>",
      "migrations_dir": "../../packages/core/migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "APP_KV", "id": "<KV_NAMESPACE_ID>" }],
  // Reader assets (exploded RWPM, under reader/) and the Journal's media library (under journal/,
  // served at /media/journal/..., app/lib/carrel/journal-media-adapter.server.ts) live in the
  // foxing-epubs R2 bucket. Nightly D1 dumps (app/lib/backup.server.ts, under backups/json/) go to
  // their own private bucket, never to a bucket served on a public domain; the Journal library's
  // earlier and deleted bytes are kept there too, under journal-media/.
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "foxing-epubs" },
    { "binding": "BACKUPS", "bucket_name": "foxing-backups" }
  ],
  // The Journal's media library: Cloudflare Images measures, turns, mirrors and shrinks its
  // pictures (site-runtime ./image editImage), and Workers AI suggests their alt text and tags,
  // through the AI Gateway that AI_GATEWAY_BASE_URL names when it is set.
  "images": { "binding": "IMAGES" },
  "ai": { "binding": "AI" },
  // The live layer: one ClubRoom Durable Object per club (fan-out only, never writes
  // D1). See workers/club-room.ts. RATE_LIMITER is site-runtime's exact counter behind
  // @foxing/api's rateLimit (packages/api/src/middleware/rate-limit.ts).
  "durable_objects": {
    "bindings": [
      { "name": "CLUB_ROOM", "class_name": "ClubRoom" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ClubRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["RateLimiter"] }
  ],
  "ratelimits": [
    // Carrel's site API (/api/carrel/v1), per caller address. Its namespace_id must be used by
    // no other Worker in the account, or the two would share one counter.
    { "name": "CARREL_RATE_LIMIT", "namespace_id": "1104", "simple": { "limit": 120, "period": 60 } }
  ],
  "send_email": [{ "name": "EMAIL" }],
  // The companion cache pipeline. Cron finds catalog books missing a cached
  // action and enqueues one message per book; the queue consumer generates and writes
  // book_ai_cache rows. See packages/core/src/companion/cache-generator.ts.
  "queues": {
    "producers": [{ "queue": "foxing-companion-cache", "binding": "COMPANION_CACHE_QUEUE" }],
    "consumers": [{ "queue": "foxing-companion-cache", "max_batch_size": 5, "max_retries": 3 }]
  },
  // 0 8: companion cache. */5: push sweep. 17 3: nightly D1 backup (workers/app.ts).
  "triggers": { "crons": ["0 8 * * *", "*/5 * * * *", "17 3 * * *"] },
  "vars": {
    "BETTER_AUTH_URL": "https://<your-worker>.workers.dev",
    "EMAIL_FROM": "hello@foxing.app",
    // Affiliate tags applied to buy links at render (public, not secret). Blank = no tag.
    "AMAZON_ASSOC_TAG": "",
    "BOOKSHOP_AFFILIATE_ID": "",
    // How many catalog books the daily cron enqueues for cache generation. Small on
    // purpose (Phase 4a proof scope); raise once real cost-per-book is measured.
    "COMPANION_CACHE_BATCH_SIZE": "20"
  }
}
